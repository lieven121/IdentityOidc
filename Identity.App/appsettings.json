{
  "Hosting": {
    "ReverseProxySupport": true,
    "AssumeEveryRequestHttps": false,
    "ReverseProxyAddresses": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Passkeys": {
    "ServerDomain": null
  },
  "OpenIddict": {
    "OnlyAllowHttps": true,
    "Issuer": null,
    "InitialPasswordDirectory": null,
    "EnforceTwoFactor": false,
    "EnforceTwoFactorRoles": [],
    "Encryption": {
      "Key": null,
      "Cert": {
        "Path": "../../identity-encryption.pfx",
        "GenerateIfEmpty": true,
        "Password": null,
        "ValidityMonths": 36

      }
    },
    "Signing": {
      "Key": null,
      "Cert": {
        "Path": "../../identity-signing.pfx",
        "GenerateIfEmpty": true,
        "Password": null,
        "ValidityMonths": 36
      }
    },

    "Roles": [
      "Admin",
      "User",
    ],
    "ApplicationConfigs": [],
    "Users": [
      {
        "Username": null,
        "Email": null,
        "Password": null,
        "Roles": []
      }
    ]
  }
}
